{
  "version": 2,
  "buildCommand": "next build",
  "installCommand": "npm install",
  "framework": "nextjs",
  "outputDirectory": ".next",
  "routes": [
    {
      "src": "/studio",
      "dest": "/studio/[[...tool]]/page"
    },
    {
      "src": "/studio/(.*)",
      "dest": "/studio/[[...tool]]/page"
    },
    {
      "src": "/(.*)",
      "dest": "/$1"
    }
  ]
} 